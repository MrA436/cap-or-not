# VerifyHire Environment Variables
# Copy this file to .env and fill in the values

# Payment link shown on the paywall. Works with any payment provider:
#  - PayPal.me link (simplest — pay manually delivers the unlock code by email)
#  - PayPal "Buy Now" button with a Return URL of
#      https://yoursite.com/result/?unlock=VH-UNLOCKED
#    (auto-unlocks the buyer without you doing anything manually)
#  - A Stripe Payment Link or Gumroad product URL work the same way
VITE_PAYMENT_LINK_URL=https://paypal.me/yourname/5

# Optional: AI API key for future LLM-based analysis (app works fully without this)
AI_API_KEY=
