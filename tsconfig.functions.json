{
  "compilerOptions": {
    "target": "ES2021",
    "module": "es2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["functions/**/*.ts", "src/types/analysis.ts", "src/services/analyzer.ts", "src/services/rdap.ts", "src/services/rateLimit.ts", "src/services/websiteCheck.ts"]
}